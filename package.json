{
  "name": "tak-i-nazvali",
  "version": "1.0.0",
  "private": true,
  "description": "Необычная география Беларуси: карта, гостевые отметки и отзывы.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "login": "wrangler login",
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev",
    "check": "tsc --noEmit && node --check public/app.js",
    "build": "npm run check",
    "test": "node tests/community.mjs",
    "deploy": "node scripts/setup.mjs",
    "deploy:check": "wrangler deploy --dry-run --outdir .deploy-check",
    "db:export": "wrangler d1 export DB --remote --output backup.sql",
    "deploy:button": "node scripts/deploy-button.mjs"
  },
  "devDependencies": {
    "wrangler": "4.92.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "miniflare": "4.20260515.0",
    "esbuild": "0.27.3"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Отзывы, оценки и гостевые отметки. Создаётся новая база D1."
      }
    }
  }
}
