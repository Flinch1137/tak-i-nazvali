{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tak-i-nazvali",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tak-i-nazvali-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tak-i-nazvali-photos"
    }
  ]
}
